# ─── Next.js / Frontend ──────────────────────────────────────────────────────
# Supabase project credentials (driver portal project)
NEXT_PUBLIC_SUPABASE_URL=https://yoltkmhtxwluqxxpewbl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Supabase Edge Function Secrets ──────────────────────────────────────────
# Set these via: supabase secrets set KEY=value --project-ref yoltkmhtxwluqxxpewbl
# Or in Supabase Dashboard → Project → Edge Functions → Secrets

# Supabase (same project)
SUPABASE_URL=https://yoltkmhtxwluqxxpewbl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# App URL — used for CORS allow-origin and email links
APP_URL=https://evexec.co.uk

# VAPID push notification keys (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY must match lib/config.ts VAPID_PUBLIC_KEY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Twilio — SMS, WhatsApp, and voice calls
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+44...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Operator emergency contact (receives SYSTEM_PANIC SMS + voice call)
OPERATOR_PHONE=+44...

# Resend — transactional email
RESEND_API_KEY=
# "From" address for driver notifications and journey receipts
RECEIPT_FROM=EV Exec <noreply@evexec.co.uk>

# FlightAware AeroAPI v4 — flight status tracking
FLIGHTAWARE_API_KEY=

# ─── Supabase Vault secret ────────────────────────────────────────────────────
# The pg_cron jobs that invoke edge functions read the service role key from
# Supabase Vault rather than storing it in plain text inside pg_cron.job.
# Create it once in the SQL editor:
#
#   select vault.create_secret('<SUPABASE_SERVICE_ROLE_KEY>', 'attestation_engine_service_key');
#
# This secret is shared between both cron jobs (attestation-engine and
# send-driver-reminders) and the notify-job-update trigger function.
